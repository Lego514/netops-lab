# Generated by `python -m netops build` from inventory/site.yaml. Do not edit by hand.
# Segmentation policy for {{ router }}: guards traffic LEAVING this router toward
# the segments it is the gateway for{% if has_internet %}, and toward the internet{% endif %}.

table inet segpolicy
delete table inet segpolicy

table inet segpolicy {
	chain forward {
		type filter hook forward priority filter; policy accept;
		ct state established,related accept
		ct state invalid drop
{% for c in chains %}
		oifname "{{ c.oif }}" jump {{ c.name }}
{% endfor %}
	}
{% for c in chains %}

	chain {{ c.name }} {
{% for r in c.rules %}
		{{ r | nft }}
{% endfor %}
	}
{% endfor %}
}
