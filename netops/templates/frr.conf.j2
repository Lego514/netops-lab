! Generated by `python -m netops build` from inventory/site.yaml. Do not edit by hand.
frr version 8.4
frr defaults traditional
hostname {{ name }}
log stdout informational
service integrated-vtysh-config
!
{% if lo_address %}
interface lo
 ip address {{ lo_address }}
!
{% endif %}
{% for i in interfaces %}
interface {{ i.name }}
 description {{ i.description }}
 ip address {{ i.address }}/{{ i.network.prefixlen }}
{% if i.kind == "p2p" %}
 ip ospf network point-to-point
{% endif %}
!
{% endfor %}
{% if ospf %}
router ospf
 ospf router-id {{ router_id }}
{% for i in interfaces if i.kind == "segment" %}
 passive-interface {{ i.name }}
{% endfor %}
{% for net in ospf.networks %}
 network {{ net }} area 0
{% endfor %}
{% if ospf.originate_default %}
 default-information originate always
{% endif %}
!
{% endif %}
{% if bgp %}
{% for route in bgp.static_blackholes %}
ip route {{ route }} blackhole
{% endfor %}
router bgp {{ bgp.asn }}
 bgp router-id {{ bgp.router_id }}
 no bgp ebgp-requires-policy
 neighbor {{ bgp.neighbor_ip }} remote-as {{ bgp.neighbor_asn }}
 neighbor {{ bgp.neighbor_ip }} description {{ bgp.neighbor_name }}
 !
 address-family ipv4 unicast
{% for net in bgp.networks %}
  network {{ net }}
{% endfor %}
 exit-address-family
!
{% endif %}
line vty
!
